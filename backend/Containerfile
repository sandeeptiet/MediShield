# MediShield backend image.
#
# Build args:
#   BAKE_MODELS=true   pre-download Qwen3 embedder + bge reranker into the image
#                      (slow build, fast cold-start). Defaults to "false" for CRC.
#
# OpenShift runs containers as a random non-root UID by default. We create a
# fixed app user but `chgrp -R 0 /app && chmod -R g=u /app` so any UID inside
# the root group can read+write — that is what OCP needs.
FROM python:3.12-slim AS base

ARG BAKE_MODELS=false

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sbert

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    libmagic1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir uv

# Dependencies first (so source-only edits don't bust the layer).
COPY pyproject.toml ./
RUN uv pip install --system .

# (Optional) pre-download embedding + reranker models into the image.
RUN if [ "$BAKE_MODELS" = "true" ]; then \
        python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; \
            SentenceTransformer('Qwen/Qwen3-Embedding-0.6B'); \
            CrossEncoder('BAAI/bge-reranker-v2-m3')"; \
    fi

# App source.
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini ./
COPY scripts/ ./scripts/

RUN mkdir -p /app/uploads /app/.cache && \
    chgrp -R 0 /app && \
    chmod -R g=u /app

USER 1001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
