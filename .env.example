# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Auth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# --- NextAuth (frontend) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# --- Database ---
MYSQL_URL=mysql+pymysql://medishield:dev@mysql:3306/medishield
MYSQL_ROOT_PASSWORD=dev
MYSQL_DATABASE=medishield
MYSQL_USER=medishield
MYSQL_PASSWORD=dev

# --- Vector store ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=policy_chunks

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=medishield-dev
LOG_LEVEL=INFO

# --- File storage ---
UPLOAD_DIR=./uploads

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
